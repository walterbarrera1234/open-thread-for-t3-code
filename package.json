{
  "name": "open-thread-for-t3-code",
  "displayName": "Open Thread for T3 Code",
  "description": "Right-click any folder to start a T3 Code thread, see which agents are working in which repos, and use T3 Code in a panel beside your code. For VS Code, Cursor, Windsurf and Antigravity.",
  "version": "0.3.0",
  "publisher": "ezequielbarrera",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "t3",
    "t3 code",
    "ai",
    "agent",
    "threads",
    "agents",
    "multi-agent",
    "dashboard"
  ],
  "extensionKind": [
    "ui"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "t3code.openFolder",
        "title": "Open Thread",
        "category": "T3 Code"
      },
      {
        "command": "t3code.openWorkspace",
        "title": "Open Thread for Current Project",
        "category": "T3 Code"
      },
      {
        "command": "t3code.showApp",
        "title": "Show in T3 Code",
        "category": "T3 Code",
        "icon": "$(link-external)"
      },
      {
        "command": "t3code.refreshAgents",
        "title": "Refresh Agents",
        "category": "T3 Code",
        "icon": "$(refresh)"
      },
      {
        "command": "t3code.openThreadInProject",
        "title": "Open New Thread",
        "category": "T3 Code",
        "icon": "$(add)"
      },
      {
        "command": "t3code.openProjectFolder",
        "title": "Open Folder in New Window",
        "category": "T3 Code",
        "icon": "$(folder-opened)"
      },
      {
        "command": "t3code.openPanel",
        "title": "Open T3 Code Panel",
        "category": "T3 Code",
        "icon": "$(layout-sidebar-right)"
      }
    ],
    "keybindings": [
      {
        "command": "t3code.openWorkspace",
        "key": "ctrl+alt+t",
        "mac": "cmd+alt+t",
        "when": "workspaceFolderCount > 0"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "t3code.openFolder",
          "when": "explorerResourceIsFolder && resourceScheme == file",
          "group": "navigation@99"
        }
      ],
      "commandPalette": [
        {
          "command": "t3code.openFolder",
          "when": "false"
        },
        {
          "command": "t3code.openWorkspace",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "t3code.openThreadInProject",
          "when": "false"
        },
        {
          "command": "t3code.openProjectFolder",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "t3code.openPanel",
          "when": "view == t3code.agents",
          "group": "navigation@0"
        },
        {
          "command": "t3code.refreshAgents",
          "when": "view == t3code.agents",
          "group": "navigation"
        },
        {
          "command": "t3code.showApp",
          "when": "view == t3code.agents",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "t3code.openThreadInProject",
          "when": "view == t3code.agents && viewItem == t3Project",
          "group": "inline@1"
        },
        {
          "command": "t3code.openProjectFolder",
          "when": "view == t3code.agents && viewItem == t3Project",
          "group": "inline@2"
        },
        {
          "command": "t3code.showApp",
          "when": "view == t3code.agents && viewItem == t3Thread",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "title": "T3 Code",
      "properties": {
        "t3code.homeDir": {
          "type": "string",
          "default": "",
          "markdownDescription": "T3 Code data directory. Leave empty to use `$T3CODE_HOME` or `~/.t3`."
        },
        "t3code.appPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to the T3 Code desktop app, used to launch it when it isn't running. Leave empty to auto-detect."
        },
        "t3code.launchIfNotRunning": {
          "type": "boolean",
          "default": true,
          "description": "Launch the T3 Code desktop app if it isn't running."
        },
        "t3code.agents.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show live T3 Code agent status: Explorer badges, the T3 Agents panel, and the status bar. Takes effect after reloading the window."
        },
        "t3code.agents.notifications": {
          "type": "string",
          "enum": [
            "all",
            "needsYou",
            "off"
          ],
          "enumDescriptions": [
            "Notify when an agent finishes, needs you, or hits an error.",
            "Only notify when an agent needs you or hits an error.",
            "No notifications."
          ],
          "default": "all",
          "description": "When to show notifications about T3 Code agents."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "t3code",
          "title": "T3 Agents",
          "icon": "resources/agents.svg"
        }
      ]
    },
    "views": {
      "t3code": [
        {
          "id": "t3code.agents",
          "name": "Agents",
          "when": "t3code.agentsEnabled"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "t3code.agents",
        "when": "!t3code.agentsAvailable",
        "contents": "Agent status isn't available yet. Make sure the T3 Code desktop app is installed and has been opened at least once.\n[Refresh](command:t3code.refreshAgents)"
      },
      {
        "view": "t3code.agents",
        "when": "t3code.agentsAvailable && t3code.agentsEmpty",
        "contents": "No T3 Code threads yet. Right-click a folder in the Explorer and choose **Open Thread** to start one."
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package",
    "vscode:prepublish": "npm run compile",
    "test": "npm run compile && node --test \"out/test/*.test.js\""
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.0.0",
    "typescript": "^5.4.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/walterbarrera1234/open-thread-for-t3-code.git"
  },
  "bugs": {
    "url": "https://github.com/walterbarrera1234/open-thread-for-t3-code/issues"
  },
  "homepage": "https://github.com/walterbarrera1234/open-thread-for-t3-code#readme"
}
